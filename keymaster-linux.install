# pacman install script

post_install() {
  cat <<'EOF'

KeyMaster Linux требует доступа к устройствам ввода:

  1. Добавьте пользователя в группу `input`:
       sudo usermod -aG input $USER

  2. Перезагрузитесь или перелогиньтесь (udev-правило для /dev/uinput
     ставится вместе с пакетом и применяется в новой сессии).

Без этого daemon не сможет захватить клавиатуру/мышь.
EOF
}

post_upgrade() {
  post_install "$1"
}
